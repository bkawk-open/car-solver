# =============================================================================
# Project Blacktub - Configuration
# Copy this file to .env and adjust values for your build
# =============================================================================

# -- Vehicle Mass Estimates (kg) --
MASS_MONOCOQUE=60
MASS_BODY_PANELS=20
MASS_ENGINE_DRIVETRAIN=80
MASS_SUSPENSION_WHEELS=60
MASS_FUEL_FLUIDS=20
MASS_DRIVER=80

# -- Vehicle Geometry --
WHEELBASE_MM=2457
FRONT_TRACK_MM=1598
REAR_TRACK_MM=1530
OVERALL_LENGTH_MM=4573
OVERALL_WIDTH_MM=1852
OVERALL_HEIGHT_MM=1279
GROUND_CLEARANCE_MM=150
COG_HEIGHT_MM=420
COG_FRONT_BIAS=0.38

# -- Wheels and Tyres --
FRONT_WHEEL_DIAMETER_IN=20
FRONT_WHEEL_WIDTH_IN=9.5
FRONT_TYRE_WIDTH_MM=255
FRONT_TYRE_ASPECT_RATIO=35
REAR_WHEEL_DIAMETER_IN=21
REAR_WHEEL_WIDTH_IN=12
REAR_TYRE_WIDTH_MM=315
REAR_TYRE_ASPECT_RATIO=30

# -- Material Properties: Forged Carbon Composite --
FIBRE_VOLUME_FRACTION=0.45
FIBRE_MODULUS_GPA=230
RESIN_MODULUS_GPA=3.5
ORIENTATION_EFFICIENCY=0.375
COMPOSITE_DENSITY_GCM3=1.49

# -- Material Properties: Printed Core --
CORE_MODULUS_GPA=5.0
CORE_THICKNESS_MM=10
CARBON_SKIN_THICKNESS_MM=2

# -- Safety Factors --
SF_GENERAL=2.0
SF_SUSPENSION_PICKUP=3.5
SF_FATIGUE_CRITICAL=3.5

# -- Optimisation Objective Weights (must sum to 1.0) --
WEIGHT_TORSION=0.50
WEIGHT_BENDING=0.20
WEIGHT_FRONT_CORNER=0.20
WEIGHT_REAR_CORNER=0.10

# -- Torsional Stiffness Target --
TORSION_TARGET_NM_PER_DEG=10000

# -- Dynamic Load Factors --
VERTICAL_G_FACTOR=3.0
LATERAL_G_FACTOR=1.5
BRAKING_G_FACTOR=1.2
BRAKING_FRONT_BIAS=0.70
LATERAL_FRONT_BIAS=0.60

# -- SIMP Algorithm Parameters --
SIMP_PENALTY=3.0
SIMP_VOLUME_FRACTION=0.30
SIMP_CONVERGENCE_TOLERANCE=0.01
SIMP_MAX_ITERATIONS=200
SIMP_FILTER_RADIUS=1.5

# -- Manufacturing Constraints --
MIN_WALL_THICKNESS_MM=3.0
CARBON_WALL_THICKNESS_MM=3.5
MAX_OVERHANG_ANGLE_DEG=45
PRINT_VOLUME_X_MM=1200
PRINT_VOLUME_Y_MM=1200
PRINT_VOLUME_Z_MM=600
MIN_LATTICE_CELL_MM=8.0
VENT_HOLE_DIAMETER_MM=0.5
